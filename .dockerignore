# --- Git & CI ---
.git
.github
.gitignore

# --- Docker ---
/Dockerfile
/.dockerignore
/docker/docker-compose.yml
/docker/config
/docker/extensions
/docker/data
/docker/plugins
/docker/dist
/public/scripts/extensions/third-party

# --- Plugins (keep only package files) ---
/plugins/*
!/plugins/package.json
!/plugins/package-lock.json

# --- The Folders ---
/backups
/cache
/data
/dist
/node_modules
/tests

# --- Not part of the server image (Phase 0 crop) ---
# Desktop host, removed AIRI subtree, removed local-model hosting, GGUF
# catalog, mobile clients and packaging must never enter the server build
# context. /airi and /src/leslie-local-model no longer exist in the tree;
# they stay listed so a re-introduction cannot silently ship.
/airi
/src/electron
/src/leslie-local-model
/models
/mobile
/packaging
/resources
/notes
/Config
/Runtime
/Run
/Cache
/logs
/extensions

# --- Sensitive Info ---
**/.env*
**/*.pem
**/certs

# --- Documentation ---
readme*
*.md

# --- OS & System Junk ---
**/.DS_Store
*.bat
*.cmd
*.exe
start.sh

# --- Dev Config ---
.editorconfig
.eslintrc.cjs
.eslintrc*
.vscode
**/jsconfig.json
.npmignore
.gemini
.nomedia

# -- Logs & Temp ---
*.log
**/tmp
